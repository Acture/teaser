diff --git a/src/termio/External.zig b/src/termio/External.zig
new file mode 100644
index 0000000..e4f4463
--- /dev/null
+++ b/src/termio/External.zig
@@ -0,0 +1,268 @@
+//! External implements terminal I/O owned by the embedding host.
+//!
+//! Unlike the exec backend, this backend never opens a PTY or starts a
+//! subprocess. Ghostty forwards encoded terminal input and resize events to
+//! synchronous host callbacks. Callback byte buffers are borrowed and only
+//! valid for the duration of the call. Callbacks must copy or enqueue data and
+//! return without calling Ghostty APIs or waiting on the surface.
+const External = @This();
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const renderer = @import("../renderer.zig");
+const terminal = @import("../terminal/main.zig");
+const termio = @import("../termio.zig");
+
+pub const WriteCallback = *const fn (
+    userdata: ?*anyopaque,
+    data: [*]const u8,
+    len: usize,
+) callconv(.c) void;
+
+pub const ResizeCallback = *const fn (
+    userdata: ?*anyopaque,
+    columns: renderer.GridSize.Unit,
+    rows: renderer.GridSize.Unit,
+    width_px: u32,
+    height_px: u32,
+) callconv(.c) void;
+
+pub const Config = struct {
+    userdata: ?*anyopaque = null,
+    write: WriteCallback,
+    resize: ResizeCallback,
+};
+
+config: Config,
+
+pub fn init(config: Config) External {
+    return .{ .config = config };
+}
+
+pub fn deinit(self: *External) void {
+    _ = self;
+}
+
+pub fn initTerminal(self: *External, term: *terminal.Terminal) void {
+    _ = self;
+    _ = term;
+}
+
+pub fn threadEnter(
+    self: *External,
+    alloc: Allocator,
+    io: *termio.Termio,
+    td: *termio.Termio.ThreadData,
+) !void {
+    _ = self;
+    _ = alloc;
+    _ = io;
+
+    td.backend = .{ .external = .{} };
+}
+
+pub fn threadExit(self: *External, td: *termio.Termio.ThreadData) void {
+    _ = self;
+    std.debug.assert(td.backend == .external);
+}
+
+pub fn focusGained(
+    self: *External,
+    td: *termio.Termio.ThreadData,
+    focused: bool,
+) !void {
+    _ = self;
+    _ = td;
+    _ = focused;
+}
+
+pub fn resize(
+    self: *External,
+    grid_size: renderer.GridSize,
+    screen_size: renderer.ScreenSize,
+) !void {
+    self.config.resize(
+        self.config.userdata,
+        grid_size.columns,
+        grid_size.rows,
+        screen_size.width,
+        screen_size.height,
+    );
+}
+
+pub fn queueWrite(
+    self: *External,
+    alloc: Allocator,
+    td: *termio.Termio.ThreadData,
+    data: []const u8,
+    linefeed: bool,
+) !void {
+    _ = td;
+    if (data.len == 0) return;
+
+    if (!linefeed or std.mem.indexOfScalar(u8, data, '\r') == null) {
+        self.config.write(self.config.userdata, data.ptr, data.len);
+        return;
+    }
+
+    const carriage_returns = std.mem.count(u8, data, "\r");
+    const len = try std.math.add(usize, data.len, carriage_returns);
+    const normalized = try alloc.alloc(u8, len);
+    defer alloc.free(normalized);
+
+    var source_index: usize = 0;
+    var destination_index: usize = 0;
+    while (source_index < data.len) : (source_index += 1) {
+        const byte = data[source_index];
+        normalized[destination_index] = byte;
+        destination_index += 1;
+        if (byte == '\r') {
+            normalized[destination_index] = '\n';
+            destination_index += 1;
+        }
+    }
+
+    std.debug.assert(destination_index == normalized.len);
+    self.config.write(
+        self.config.userdata,
+        normalized.ptr,
+        normalized.len,
+    );
+}
+
+pub fn childExitedAbnormally(
+    self: *External,
+    alloc: Allocator,
+    term: *terminal.Terminal,
+    exit_code: u32,
+    runtime_ms: u64,
+) !void {
+    _ = self;
+    _ = alloc;
+    _ = term;
+    _ = exit_code;
+    _ = runtime_ms;
+}
+
+/// External backends keep no process, PTY, or event-loop state.
+pub const ThreadData = struct {
+    pub fn deinit(self: *ThreadData, alloc: Allocator) void {
+        _ = self;
+        _ = alloc;
+    }
+};
+
+const TestState = struct {
+    bytes: [64]u8 = undefined,
+    byte_count: usize = 0,
+    write_lengths: [4]usize = undefined,
+    write_count: usize = 0,
+    resize_count: usize = 0,
+    columns: renderer.GridSize.Unit = 0,
+    rows: renderer.GridSize.Unit = 0,
+    width_px: u32 = 0,
+    height_px: u32 = 0,
+
+    fn write(
+        userdata: ?*anyopaque,
+        data: [*]const u8,
+        len: usize,
+    ) callconv(.c) void {
+        const self: *TestState = @ptrCast(@alignCast(userdata.?));
+        std.debug.assert(self.byte_count + len <= self.bytes.len);
+        std.debug.assert(self.write_count < self.write_lengths.len);
+
+        @memcpy(
+            self.bytes[self.byte_count..][0..len],
+            data[0..len],
+        );
+        self.byte_count += len;
+        self.write_lengths[self.write_count] = len;
+        self.write_count += 1;
+    }
+
+    fn resize(
+        userdata: ?*anyopaque,
+        columns: renderer.GridSize.Unit,
+        rows: renderer.GridSize.Unit,
+        width_px: u32,
+        height_px: u32,
+    ) callconv(.c) void {
+        const self: *TestState = @ptrCast(@alignCast(userdata.?));
+        self.resize_count += 1;
+        self.columns = columns;
+        self.rows = rows;
+        self.width_px = width_px;
+        self.height_px = height_px;
+    }
+};
+
+test "external termio forwards writes in order" {
+    var state: TestState = .{};
+    var external: External = .init(.{
+        .userdata = &state,
+        .write = &TestState.write,
+        .resize = &TestState.resize,
+    });
+    var td: termio.Termio.ThreadData = undefined;
+
+    try external.threadEnter(
+        std.testing.allocator,
+        undefined,
+        &td,
+    );
+    try external.queueWrite(std.testing.allocator, &td, "one", false);
+    try external.queueWrite(std.testing.allocator, &td, "two\r", true);
+    try external.queueWrite(std.testing.allocator, &td, "three", false);
+
+    try std.testing.expectEqual(@as(usize, 3), state.write_count);
+    try std.testing.expectEqualSlices(
+        usize,
+        &.{ 3, 5, 5 },
+        state.write_lengths[0..state.write_count],
+    );
+    try std.testing.expectEqualStrings(
+        "onetwo\r\nthree",
+        state.bytes[0..state.byte_count],
+    );
+}
+
+test "external termio forwards resize" {
+    var state: TestState = .{};
+    var external: External = .init(.{
+        .userdata = &state,
+        .write = &TestState.write,
+        .resize = &TestState.resize,
+    });
+
+    try external.resize(
+        .{ .columns = 120, .rows = 40 },
+        .{ .width = 1440, .height = 900 },
+    );
+
+    try std.testing.expectEqual(@as(usize, 1), state.resize_count);
+    try std.testing.expectEqual(@as(renderer.GridSize.Unit, 120), state.columns);
+    try std.testing.expectEqual(@as(renderer.GridSize.Unit, 40), state.rows);
+    try std.testing.expectEqual(@as(u32, 1440), state.width_px);
+    try std.testing.expectEqual(@as(u32, 900), state.height_px);
+}
+
+test "external termio has no exec thread state" {
+    var state: TestState = .{};
+    var external: External = .init(.{
+        .userdata = &state,
+        .write = &TestState.write,
+        .resize = &TestState.resize,
+    });
+    var td: termio.Termio.ThreadData = undefined;
+
+    try external.threadEnter(
+        std.testing.allocator,
+        undefined,
+        &td,
+    );
+    defer external.threadExit(&td);
+
+    try std.testing.expect(td.backend == .external);
+    try std.testing.expectEqual(@as(usize, 0), @sizeOf(ThreadData));
+}
