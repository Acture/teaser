dotenv_if_exists .env

# A worktree has no .env of its own, and the signing identity is the same one
# for every checkout of this repository. Fall back to the checkout that owns
# the repository rather than copying the file into each worktree, where the
# copies would drift apart.
if [ -z "${TEASER_CODESIGN_IDENTITY:-}" ]; then
	dotenv_if_exists "$(git rev-parse --path-format=absolute --git-common-dir)/../.env"
fi
