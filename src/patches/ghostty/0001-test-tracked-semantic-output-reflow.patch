+test "Terminal: tracked semantic output survives reflow through OSC 133" {
+    const alloc = testing.allocator;
+
+    var t = try init(alloc, .{
+        .cols = 80,
+        .rows = 24,
+        .max_scrollback = 0,
+    });
+    defer t.deinit(alloc);
+
+    var stream = t.vtStream();
+    defer stream.deinit();
+
+    try stream.nextSlice("\x1b]133;A\x07");
+    try stream.nextSlice("$ ");
+    try stream.nextSlice("\x1b]133;B\x07");
+    try stream.nextSlice("printf alpha-beta-gamma");
+    try stream.nextSlice("\r\n");
+    try stream.nextSlice("\x1b]133;C\x07");
+    try stream.nextSlice("alpha-beta-gamma\r\nsecond-line\r\n");
+    try stream.nextSlice("\x1b]133;D;0\x07");
+    try stream.nextSlice("\x1b]133;A\x07");
+    try stream.nextSlice("$ ");
+
+    const screen = t.screens.active;
+    const output_pin = screen.pages.pin(.{ .active = .{
+        .x = 0,
+        .y = 1,
+    } }).?;
+    const output = screen.selectOutput(output_pin).?;
+    var tracked = try output.track(screen);
+    defer tracked.deinit(screen);
+
+    {
+        const actual = try screen.selectionString(alloc, .{ .sel = tracked });
+        defer alloc.free(actual);
+        try testing.expectEqualStrings(
+            "alpha-beta-gamma\nsecond-line",
+            actual,
+        );
+    }
+
+    try t.resize(alloc, 7, 24);
+    {
+        const actual = try screen.selectionString(alloc, .{ .sel = tracked });
+        defer alloc.free(actual);
+        try testing.expectEqualStrings(
+            "alpha-beta-gamma\nsecond-line",
+            actual,
+        );
+    }
+
+    try t.resize(alloc, 80, 24);
+    {
+        const actual = try screen.selectionString(alloc, .{ .sel = tracked });
+        defer alloc.free(actual);
+        try testing.expectEqualStrings(
+            "alpha-beta-gamma\nsecond-line",
+            actual,
+        );
+    }
+}
+
 test "Terminal: semantic prompt continuations" {
